# Default: treat everything as text and normalize the line endings to LF
* text=auto eol=lf

# Markdown files: readable diffs
*.md diff=markdown

# Binary files (SVG is text: it keeps its diffs)
*.png binary

# Left out of the archive of the package (git archive)

# Folders
/.github export-ignore
/assets export-ignore
/tests export-ignore

# Files
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.markdownlint.json export-ignore
/.markdownlintignore export-ignore
/.prettierignore export-ignore
/.stylelintignore export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md export-ignore
/eslint.config.mjs export-ignore
/prettier.config.mjs export-ignore
/SECURITY.md export-ignore
/stylelint.config.mjs export-ignore
/tsconfig.json export-ignore
/vitest.config.mjs export-ignore
