{
  "name": "@stanislas-poisson/js-dev-tools",
  "version": "1.0.0",
  "description": "The quality tools of the JavaScript and TypeScript projects: ESLint, Prettier, Stylelint, Vitest, TypeScript and markdownlint configurations, as a base that a project extends.",
  "keywords": [
    "dev-tools",
    "eslint",
    "prettier",
    "stylelint",
    "vitest",
    "typescript",
    "markdownlint",
    "code-quality"
  ],
  "homepage": "https://github.com/Stanislas-Poisson/js-dev-tools#readme",
  "bugs": {
    "url": "https://github.com/Stanislas-Poisson/js-dev-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stanislas-Poisson/js-dev-tools.git"
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://www.patreon.com/c/zairakai"
    },
    {
      "type": "twitch",
      "url": "https://www.twitch.tv/zairakai"
    }
  ],
  "license": "MIT",
  "author": "Stanislas Poisson <stanislas.p@the-white-rabbits.fr> (https://github.com/Stanislas-Poisson)",
  "type": "module",
  "exports": {
    "./eslint": "./config/eslint.config.js",
    "./prettier": "./config/prettier.config.js",
    "./stylelint": "./config/stylelint.config.js",
    "./vitest": "./config/vitest.config.js",
    "./tsconfig": "./config/tsconfig.base.json",
    "./markdownlint": "./config/.markdownlint.json",
    "./config/*": "./config/*"
  },
  "files": [
    "config/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "eslint": "eslint --config config/eslint.config.js config tests",
    "markdownlint": "markdownlint-cli2 --config config/.markdownlint.json '**/*.md' '#node_modules' '#.github'",
    "prettier": "prettier . --check --config config/prettier.config.js --ignore-path config/.prettierignore",
    "prettier:fix": "prettier . --write --config config/prettier.config.js --ignore-path config/.prettierignore",
    "test": "vitest run",
    "quality": "npm run eslint && npm run prettier && npm run markdownlint && npm test"
  },
  "dependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-php": "^0.25.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-blade": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.3.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "markdownlint-cli2": "^0.23.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "markdown-it": "14.3.2",
    "nanoid": "3.3.20",
    "smol-toml": "1.9.0",
    "colord": "2.9.7",
    "fast-uri": "3.1.8",
    "js-yaml": {
      ".": "4.3.2"
    },
    "brace-expansion": "5.0.12"
  }
}
